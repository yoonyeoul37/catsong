<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 위젯 B안: 위 사진 + 지금 듣는 것 / 아래 바로가기 4개 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/paran_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 위: 시간대 라디오 사진 + 글자 + 버튼 -->
    <FrameLayout
        android:id="@+id/widget_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/paran_widget_photo_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="Paransori"
            android:textColor="#F2FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="파란소리"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="음악 · 라디오 · 자연을 들어보세요"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/paran_ic_prev"
                android:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/paran_widget_play"
                android:padding="9dp"
                android:src="@drawable/paran_ic_play"
                android:tint="#17140F" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/paran_ic_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- 아래: 바로가기 4개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_go_music"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/paran_widget_chip"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/paran_ic_music"
                android:tint="@color/paran_w_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="음악"
                android:textColor="@color/paran_w_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_go_radio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/paran_widget_chip"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/paran_ic_radio"
                android:tint="@color/paran_w_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="라디오"
                android:textColor="@color/paran_w_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_go_nature"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/paran_widget_chip"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/paran_ic_leaf"
                android:tint="@color/paran_w_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="자연"
                android:textColor="@color/paran_w_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_go_sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/paran_widget_chip"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/paran_ic_moon"
                android:tint="@color/paran_w_sub" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="수면"
                android:textColor="@color/paran_w_ink"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
